{
  "version": 1,
  "description": "Golden vectors for the search normalizer. The Dart ArabicNormalizer and the SQL app.normalize_ar must both map every input to exactly its expected output. Keep inputs portable (no cases that depend on full NFKC beyond what both sides implement).",
  "cases": [
    {"name": "empty", "input": "", "expected": ""},
    {"name": "whitespace only", "input": " \t\n   ", "expected": ""},
    {"name": "alef hamza above", "input": "أحمد", "expected": "احمد"},
    {"name": "alef hamza below", "input": "إلغاء", "expected": "الغاء"},
    {"name": "alef madda", "input": "آخر", "expected": "اخر"},
    {"name": "alef wasla", "input": "ٱلاشتراك", "expected": "الاشتراك"},
    {"name": "teh marbuta", "input": "باقة", "expected": "باقه"},
    {"name": "teh marbuta plural phrase", "input": "فاتورة الشهر", "expected": "فاتوره الشهر"},
    {"name": "alef maqsura", "input": "مستوى", "expected": "مستوي"},
    {"name": "farsi yeh", "input": "ی", "expected": "ي"},
    {"name": "farsi keheh", "input": "کارت", "expected": "كارت"},
    {"name": "waw hamza", "input": "مسؤول", "expected": "مسوول"},
    {"name": "yeh hamza", "input": "رسائل", "expected": "رسايل"},
    {"name": "standalone hamza kept", "input": "ماء سماء", "expected": "ماء سماء"},
    {"name": "tashkeel", "input": "اشْتِرَاكٌ", "expected": "اشتراك"},
    {"name": "shadda and tanween", "input": "مُحَمَّدٌ رَصِيدًا", "expected": "محمد رصيدا"},
    {"name": "dagger alef", "input": "هٰذا", "expected": "هذا"},
    {"name": "quranic marks", "input": "كلمةۖ", "expected": "كلمه"},
    {"name": "tatweel", "input": "رصـــيد", "expected": "رصيد"},
    {"name": "arabic-indic digits", "input": "٠١٢٣٤٥٦٧٨٩", "expected": "0123456789"},
    {"name": "persian digits", "input": "۰۱۲۳۴۵۶۷۸۹", "expected": "0123456789"},
    {"name": "arabic digits in ussd", "input": "*٩٩٩#", "expected": "*999#"},
    {"name": "arabic punctuation", "input": "نعم، لا؛ ماذا؟", "expected": "نعم, لا; ماذا?"},
    {"name": "latin lowercase", "input": "SIM Card", "expected": "sim card"},
    {"name": "mixed ar en", "input": "باقة DATA ١٠ GB", "expected": "باقه data 10 gb"},
    {"name": "collapse whitespace", "input": "  رصيد \t\n  الخط  ", "expected": "رصيد الخط"},
    {"name": "nbsp", "input": "رصيد الخط", "expected": "رصيد الخط"},
    {"name": "zero width removed", "input": "ر‌ص‍يد​", "expected": "رصيد"},
    {"name": "bidi marks removed", "input": "‏*999#‎", "expected": "*999#"},
    {"name": "bidi embeddings removed", "input": "‫نت‬ ⁧data⁩", "expected": "نت data"},
    {"name": "bom removed", "input": "﻿رصيد", "expected": "رصيد"},
    {"name": "elongation collapsed", "input": "عااااجل", "expected": "عاجل"},
    {"name": "elongation of three", "input": "ههههه", "expected": "ه"},
    {"name": "double letter kept", "input": "الله مدد", "expected": "الله مدد"},
    {"name": "elongation after folding", "input": "اأإآ", "expected": "ا"},
    {"name": "elongation through tashkeel", "input": "يَاااا", "expected": "يا"},
    {"name": "digits never collapsed", "input": "10000", "expected": "10000"},
    {"name": "latin never collapsed", "input": "goooal", "expected": "goooal"},
    {"name": "ussd symbols kept", "input": "اطلب *999*1#", "expected": "اطلب *999*1#"},
    {"name": "plus and dash kept", "input": "+20 100-000-0000", "expected": "+20 100-000-0000"},
    {"name": "franco digits not converted", "input": "ba2a 3arabi", "expected": "ba2a 3arabi"},
    {"name": "brand ampersand kept", "input": "E& Money", "expected": "e& money"},
    {"name": "lam alef ligature", "input": "ﻻتصال", "expected": "لاتصال"},
    {"name": "lam alef hamza ligature", "input": "ﻷكثر", "expected": "لاكثر"},
    {"name": "presentation forms letters", "input": "ﺑﺎﻗﺔ", "expected": "باقه"},
    {"name": "fullwidth ussd", "input": "＊９９９＃", "expected": "*999#"},
    {"name": "fullwidth latin", "input": "ＳＩＭ", "expected": "sim"},
    {"name": "decomposed hamza", "input": "أحمد", "expected": "احمد"},
    {"name": "price text", "input": "٥٠ جنيهًا", "expected": "50 جنيها"},
    {"name": "decimal kept", "input": "1.5 جيجا", "expected": "1.5 جيجا"}
  ]
}
